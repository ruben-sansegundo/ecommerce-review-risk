# Copy this file to `.env` and paste your Kaggle API token.
#
# Get it at https://www.kaggle.com/settings/api -> "Generate New Token".
# Copy the token string shown in the UI (kaggle>=2.x uses a single token,
# not the legacy KAGGLE_USERNAME / KAGGLE_KEY pair).
#
# `.env` is gitignored. Never commit real credentials.

KAGGLE_API_TOKEN=
